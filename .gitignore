# macOS
.DS_Store
._*

# SwiftPM build products
/.build/

# The app and disk image built by build.sh
/ROSilicon.app/
/ROSilicon-*.dmg

# The Wine tree the app ships (make restore)
/.wine-runtime/

# The Steam stub the app ships (make steam-stub)
/.steam-stub/

# The d3d9.dll tools/d9vk/build.sh produces (make d9vk); without one, build.sh
# falls back to the copy checked in under Resources/d9vk
/.d9vk/
