+/***********************************************************************
+ *              macdrv_get_fitting_windowed_mode
+ *
+ * Returns the largest even-sized client area whose titled Wine window fits
+ * within the display's AppKit usable frame. visibleFrame already excludes the
+ * menu bar, notch and Dock; NSWindow supplies the current OS's title-bar and
+ * border geometry rather than relying on a fixed allowance.
+ */
+int macdrv_get_fitting_windowed_mode(CGDirectDisplayID display_id, CGSize *size)
+{
+@autoreleasepool
+{
+    NSArray<NSScreen *> *screens = [NSScreen screens];
+
+    if (!size)
+        return -1;
+
+    for (NSScreen *screen in screens)
+    {
+        CGDirectDisplayID screen_display_id =
+            [[screen deviceDescription][@"NSScreenNumber"] unsignedIntValue];
+        NSWindowStyleMask style = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                                  NSWindowStyleMaskMiniaturizable;
+        CGSize candidate;
+        NSUInteger width, height;
+
+        if (screen_display_id != display_id)
+            continue;
+
+        candidate = cgsize_win_from_mac(
+            [NSWindow contentRectForFrameRect:screen.visibleFrame styleMask:style].size);
+        if (candidate.width < 640 || candidate.height < 480 ||
+            candidate.width > 8192 || candidate.height > 8192)
+            return -1;
+
+        width = (NSUInteger)candidate.width & ~(NSUInteger)1;
+        height = (NSUInteger)candidate.height & ~(NSUInteger)1;
+        if (width < 640 || height < 480)
+            return -1;
+
+        size->width = width;
+        size->height = height;
+        return 0;
+    }
+
+    return -1;
+}
+}
