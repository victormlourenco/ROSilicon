+static BOOL fit_usable_screen_mode_enabled(void)
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[32])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    WCHAR nameW[64];
+    HKEY hkey;
+    BOOL enabled = FALSE;
+
+    /* @@ Wine registry key: HKCU\Software\Wine\Mac Driver */
+    if (!(hkey = open_hkcu_key("Software\\Wine\\Mac Driver")))
+        return FALSE;
+
+    asciiz_to_unicode(nameW, "ROSiliconFitUsableScreenMode");
+    if (query_reg_value(hkey, nameW, value, sizeof(buffer)) >= sizeof(WCHAR) &&
+        value->Type == REG_SZ)
+    {
+        const WCHAR *setting = (const WCHAR *)value->Data;
+        enabled = setting[0] == 'y' || setting[0] == 'Y' ||
+                  setting[0] == 't' || setting[0] == 'T' || setting[0] == '1';
+    }
+
+    NtClose(hkey);
+    return enabled;
+}
