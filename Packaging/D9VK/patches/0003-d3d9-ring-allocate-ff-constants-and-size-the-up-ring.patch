+  void D3D9DeviceEx::ReportDrawStats() {
+    if (likely(m_d3d9Options.drawStatsInterval <= 0))
+      return;
+
+    m_drawStats.frames++;
+
+    auto now = dxvk::high_resolution_clock::now();
+
+    const auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
+      now - m_drawStatsLast).count();
+
+    if (likely(elapsed < m_d3d9Options.drawStatsInterval))
+      return;
+
+    // Renames are what the counters are really about: each one invalidates a
+    // backing allocation and dirties everything bound to it. Report them per
+    // frame, next to the draws that would otherwise have caused one each.
+    const uint64_t frames = std::max<uint64_t>(m_drawStats.frames, 1);
+
+    const uint64_t ffVsAllocs  = m_vsFixedFunction.GetAllocCount()  - m_drawStats.ffVsAllocsAtLast;
+    const uint64_t ffVsRenames = m_vsFixedFunction.GetRenameCount() - m_drawStats.ffVsRenamesAtLast;
+
+    Logger::info(str::format(
+      "D3D9 draw stats over ", frames, " frames (per frame):"
+      "\n  UP draws              ", m_drawStats.upDraws / frames,
+      " (", m_drawStats.upBaseVertexDraws, " of ", m_drawStats.upDraws, " took firstVertex)"
+      "\n  UP ring wraps         ", double(m_drawStats.upWraps) / double(frames),
+      "\n  UP bytes requested    ", m_drawStats.upBytesRequested / frames,
+      "\n  UP bytes reserved     ", m_drawStats.upBytesReserved / frames,
+      " (", m_drawStats.upBytesReserved
+              ? (100 * (m_drawStats.upBytesReserved - m_drawStats.upBytesRequested))
+                 / m_drawStats.upBytesReserved
+              : 0,
+      "% padding)"
+      "\n  FF VS const uploads   ", ffVsAllocs / frames,
+      "\n  FF VS const renames   ", double(ffVsRenames) / double(frames)));
+
+    m_drawStats.ffVsAllocsAtLast  = m_vsFixedFunction.GetAllocCount();
+    m_drawStats.ffVsRenamesAtLast = m_vsFixedFunction.GetRenameCount();
+
+    m_drawStats.frames            = 0;
+    m_drawStats.upDraws           = 0;
+    m_drawStats.upBaseVertexDraws = 0;
+    m_drawStats.upBytesRequested  = 0;
+    m_drawStats.upBytesReserved   = 0;
+    m_drawStats.upWraps           = 0;
+
+    m_drawStatsLast = now;
+  }
