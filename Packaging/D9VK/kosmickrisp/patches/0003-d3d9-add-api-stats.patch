+  void D3D9DeviceEx::ReportApiStats() {
+    if (likely(m_d3d9Options.apiStatsInterval <= 0))
+      return;
+
+    m_apiStats.frames++;
+
+    auto now = dxvk::high_resolution_clock::now();
+    auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - m_apiStatsLast).count();
+
+    if (likely(elapsed < 1000 * m_d3d9Options.apiStatsInterval))
+      return;
+
+    const auto& s = m_apiStats;
+    const double f = double(std::max<uint64_t>(s.frames, 1u));
+    auto pf = [f] (uint64_t v) { return str::format(uint64_t(double(v) / f + 0.5)); };
+
+    Logger::info(str::format(
+      "D3D9 API stats: ", s.frames, " frames in ", elapsed, " ms (", uint64_t(double(s.frames) * 1000.0 / double(elapsed) + 0.5), " fps), per frame:",
+      "\n  draws                 DP ", pf(s.draws[0]), ", DIP ", pf(s.draws[1]), ", DP UP ", pf(s.draws[2]), ", DIP UP ", pf(s.draws[3]),
+      "\n  by primitive          points ", pf(s.drawsByPrim[1]), ", lines ", pf(s.drawsByPrim[2]), ", line strips ", pf(s.drawsByPrim[3]),
+        ", triangles ", pf(s.drawsByPrim[4]), ", strips ", pf(s.drawsByPrim[5]), ", fans ", pf(s.drawsByPrim[6]),
+      "\n  primitives            ", pf(s.primitives),
+      "\n  indexed 16/32-bit     ", pf(s.index16Draws), " / ", pf(s.index32Draws),
+      "\n  programmable VS/PS    ", pf(s.programmableVsDraws), " / ", pf(s.programmablePsDraws),
+      "\n  vertex decl changes   ", pf(s.declChanges),
+      "\n  texture changes       ", pf(s.textureChanges),
+      "\n  SetTransform          ", pf(s.transformCalls), " (", pf(s.transformChanges), " changed a matrix)",
+      "\n  render state changes  ", pf(s.renderStateChanges),
+      "\n  stage/sampler changes ", pf(s.stageStateChanges), " / ", pf(s.samplerStateChanges),
+      "\n  SetStreamSource       ", pf(s.streamSourceCalls),
+      "\n  Clear / SetRenderTarget ", pf(s.clears), " / ", pf(s.renderTargetCalls)));
+
+    m_apiStats = D3D9ApiStats();
+    m_apiStatsLast = now;
+  }
